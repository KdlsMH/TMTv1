{
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    },
    "api/generate-motivation.js": {
      "maxDuration": 60
    },
    "api/tasks/[id].js": {
      "maxDuration": 10
    },
    "api/sessions/[id].js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
